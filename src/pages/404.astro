---
/**
 * 404 — Custom "Page Not Found" with friendly messaging and navigation CTAs.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
---

<PageLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Head back to the La King Nursery homepage or contact us for help."
>
  <section class="py-24 md:py-32 lg:py-40 bg-cream-50" aria-label="Page not found">
    <Container>
      <div class="max-w-2xl mx-auto text-center">
        <!-- Large 404 number -->
        <div class="relative mb-6">
          <span
            class="block font-heading text-[8rem] md:text-[10rem] lg:text-[12rem] font-bold text-sage-200 leading-none select-none"
            aria-hidden="true"
          >
            404
          </span>
          <!-- Decorative leaf -->
          <span
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl md:text-6xl select-none opacity-60"
            aria-hidden="true"
          >
            &#127807;
          </span>
        </div>

        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-bark-800 mb-4">
          Page Not Found
        </h1>

        <p class="font-body text-lg md:text-xl text-bark-500 leading-relaxed mb-10 max-w-lg mx-auto">
          Looks like this page has been replanted somewhere else. Let's get you back on track.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button variant="primary" href="/" size="lg">
            Go Home
          </Button>
          <Button variant="secondary" href="/contact/" size="lg">
            Contact Us
          </Button>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
