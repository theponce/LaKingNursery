---
/**
 * Blog Index — Listing page pulling from content collection,
 * with featured post, grid of posts, and newsletter CTA.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/global/Breadcrumbs.astro';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import { Leaf, Mail } from '@lucide/astro';

// Get all published posts, sorted by date (newest first)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Featured post is either marked featured or the most recent
const featuredPost = sortedPosts.find((p) => p.data.featured) ?? sortedPosts[0];
const gridPosts = sortedPosts.filter((p) => p.id !== featuredPost.id);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<PageLayout
  title="Blog | Tips & Inspiration"
  description="Seasonal growing guides, landscaping ideas, and expert gardening advice from La King Nursery in Kingsville, TX. Learn what to plant and when in South Texas."
>
  <!-- Hero Banner -->
  <section class="bg-sage-800 py-16 md:py-20" aria-label="Blog introduction">
    <Container>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Blog' },
        ]}
      />
      <div class="max-w-2xl">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
          Tips & Inspiration
        </h1>
        <p class="font-body text-lg md:text-xl text-sage-200 leading-relaxed">
          Seasonal growing guides, landscaping ideas, and expert advice from your neighborhood nursery.
        </p>
      </div>
    </Container>
  </section>

  <!-- Featured Post -->
  {featuredPost && (
    <section class="reveal py-16 md:py-20 bg-cream-50" aria-labelledby="featured-post-heading">
      <Container>
        <p class="font-body text-sm font-semibold uppercase tracking-widest text-terra-500 mb-6">
          Featured Article
        </p>
        <h2 id="featured-post-heading" class="sr-only">Featured Blog Post</h2>

        <a
          href={`/blog/${featuredPost.id}/`}
          class="group block"
        >
          <div class="rounded-2xl border border-cream-200 bg-white overflow-hidden transition-shadow hover:shadow-lg">
            <div class="grid grid-cols-1 md:grid-cols-2">
              <!-- Image Placeholder -->
              <div
                class="aspect-video md:aspect-auto md:min-h-[320px] bg-cream-200 flex flex-col items-center justify-center"
                role="img"
                aria-label={`Featured post image: ${featuredPost.data.title}`}
              >
                <Leaf size={48} class="text-cream-400 mb-2" aria-hidden="true" />
                <span class="font-body text-cream-500 text-sm font-medium">Featured Photo</span>
              </div>

              <!-- Content -->
              <div class="p-6 md:p-8 lg:p-10 flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-3">
                  <Badge variant="sage">{featuredPost.data.category}</Badge>
                  <time
                    datetime={featuredPost.data.date.toISOString().split('T')[0]}
                    class="font-body text-xs text-bark-400 uppercase tracking-wider"
                  >
                    {formatDate(featuredPost.data.date)}
                  </time>
                </div>

                <h3 class="font-heading text-2xl md:text-3xl font-bold text-bark-800 mb-4 leading-snug group-hover:text-sage-700 transition-colors">
                  {featuredPost.data.title}
                </h3>

                <p class="font-body text-bark-500 leading-relaxed mb-6">
                  {featuredPost.data.description}
                </p>

                <span class="inline-flex items-center gap-1 font-body font-semibold text-sage-600 group-hover:text-sage-700 transition-colors">
                  Read More
                  <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
                </span>
              </div>
            </div>
          </div>
        </a>
      </Container>
    </section>
  )}

  <!-- Post Grid -->
  <section class="reveal py-16 md:py-20 bg-white" aria-labelledby="posts-heading">
    <Container>
      <h2 id="posts-heading" class="font-heading text-2xl md:text-3xl font-bold text-bark-800 mb-8">
        Latest Articles
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
        {gridPosts.map((post) => (
          <div class="rounded-2xl border border-cream-200 bg-cream-50 overflow-hidden transition-shadow hover:shadow-md flex flex-col reveal">
            <!-- Image Placeholder -->
            <div
              class="aspect-video bg-cream-200 flex flex-col items-center justify-center"
              role="img"
              aria-label={`Blog post image: ${post.data.title}`}
            >
              <Leaf size={32} class="text-cream-400 mb-1" aria-hidden="true" />
              <span class="font-body text-cream-500 text-xs font-medium">Blog Photo</span>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <div class="flex items-center gap-3 mb-2">
                <Badge variant="sage">{post.data.category}</Badge>
                <time
                  datetime={post.data.date.toISOString().split('T')[0]}
                  class="font-body text-xs text-bark-400 uppercase tracking-wider"
                >
                  {formatDate(post.data.date)}
                </time>
              </div>

              <h3 class="font-heading text-lg font-bold text-bark-800 mb-2 leading-snug">
                <a
                  href={`/blog/${post.id}/`}
                  class="hover:text-sage-700 transition-colors"
                >
                  {post.data.title}
                </a>
              </h3>

              <p class="font-body text-bark-500 text-sm leading-relaxed line-clamp-2 mb-4 flex-1">
                {post.data.description}
              </p>

              <a
                href={`/blog/${post.id}/`}
                class="inline-flex items-center gap-1 font-body font-semibold text-sage-600 hover:text-sage-700 transition-colors text-sm mt-auto group"
              >
                Read More
                <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- Newsletter CTA -->
  <section class="reveal bg-sage-700 py-16 md:py-20" aria-labelledby="newsletter-heading">
    <Container size="narrow">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-14 h-14 bg-sage-600 rounded-full mb-6">
          <Mail size={28} class="text-white" aria-hidden="true" />
        </div>

        <h2
          id="newsletter-heading"
          class="font-heading text-2xl md:text-3xl font-bold text-white mb-4"
        >
          Stay in the Loop
        </h2>

        <p class="font-body text-sage-200 text-lg leading-relaxed mb-8 max-w-xl mx-auto">
          Subscribe for monthly growing tips and seasonal planting reminders.
        </p>

        <form
          action="#"
          method="POST"
          class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 max-w-md mx-auto"
        >
          <label for="newsletter-email" class="sr-only">Email address</label>
          <input
            type="email"
            id="newsletter-email"
            name="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="flex-1 rounded-lg border border-sage-500 bg-sage-600 px-4 py-3 font-body text-white placeholder:text-sage-300 focus:outline-none focus:ring-2 focus:ring-gold-400 focus:border-gold-400 transition-colors"
          />
          <Button variant="cta" type="submit" size="md" class="sm:flex-shrink-0">
            Subscribe
          </Button>
        </form>

        <p class="font-body text-xs text-sage-400 mt-4">
          No spam, ever. Unsubscribe anytime.
        </p>
      </div>
    </Container>
  </section>
</PageLayout>
