---
/**
 * Gallery page — portfolio of completed projects with category filters.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { Phone, Camera } from '@lucide/astro';
import { businessInfo } from '../data/businessInfo';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Gallery' },
];

const categories = ['All', 'Landscaping', 'Plants', 'Hardscaping', 'Before & After'];

/**
 * Gallery items with varying aspect ratios to create a
 * natural masonry feel via CSS columns.
 */
const galleryItems = [
  { title: 'Coastal Bend Landscape Transformation', category: 'Landscaping', aspect: 'aspect-[3/4]' },
  { title: 'Native Plant Garden', category: 'Plants', aspect: 'aspect-video' },
  { title: 'Stone Patio Installation', category: 'Hardscaping', aspect: 'aspect-square' },
  { title: 'Drought-Tolerant Front Yard', category: 'Landscaping', aspect: 'aspect-video' },
  { title: 'Seasonal Color Display', category: 'Plants', aspect: 'aspect-[3/4]' },
  { title: 'Retaining Wall & Garden Beds', category: 'Hardscaping', aspect: 'aspect-square' },
  { title: 'Backyard Before & After', category: 'Before & After', aspect: 'aspect-video' },
  { title: 'Tropical Palm Arrangement', category: 'Plants', aspect: 'aspect-square' },
  { title: 'Full Property Redesign', category: 'Landscaping', aspect: 'aspect-[3/4]' },
  { title: 'Paver Walkway Project', category: 'Hardscaping', aspect: 'aspect-video' },
  { title: 'Front Yard Transformation', category: 'Before & After', aspect: 'aspect-[3/4]' },
  { title: 'Succulent & Cactus Display', category: 'Plants', aspect: 'aspect-square' },
];
---

<PageLayout
  title="Gallery"
  description="Browse our portfolio of landscaping, plant installations, hardscaping, and garden transformations in Kingsville and South Texas."
>
  <!-- Hero Banner -->
  <section
    class="reveal relative bg-gradient-to-br from-sage-900 via-sage-800 to-sage-700 py-20 overflow-hidden"
    aria-label="Our Work"
  >
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: radial-gradient(circle at 40% 40%, rgba(255,255,255,0.15) 0%, transparent 50%), radial-gradient(circle at 70% 60%, rgba(255,255,255,0.1) 0%, transparent 40%);"
      aria-hidden="true"
    ></div>

    <Container class="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Our Work
        </h1>
        <p class="text-lg md:text-xl text-cream-200 leading-relaxed max-w-2xl mx-auto">
          See the transformations and beautiful spaces we've created for South Texas families.
        </p>
      </div>
    </Container>
  </section>

  <!-- Breadcrumbs -->
  <Container>
    <Breadcrumbs items={breadcrumbs} />
  </Container>

  <!-- Filter Bar + Gallery Grid -->
  <section class="reveal py-16 md:py-24" aria-labelledby="gallery-heading">
    <Container>
      <h2 id="gallery-heading" class="sr-only">Project Gallery</h2>

      <!-- Category Filter Pills -->
      <nav aria-label="Gallery categories" class="mb-12">
        <ul class="flex flex-wrap items-center justify-center gap-2">
          {categories.map((cat, index) => (
            <li>
              <button
                type="button"
                class:list={[
                  'font-body font-semibold text-sm px-5 py-2.5 rounded-full border transition-all duration-200',
                  index === 0
                    ? 'bg-sage-600 text-white border-sage-600'
                    : 'bg-white text-bark-500 border-cream-300 hover:border-sage-300 hover:text-sage-600',
                ]}
                aria-pressed={index === 0 ? 'true' : 'false'}
              >
                {cat}
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Masonry Grid -->
      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
        {galleryItems.map((item) => (
          <div class="reveal break-inside-avoid rounded-xl overflow-hidden group relative">
            <!-- Image Placeholder -->
            <div class:list={[item.aspect, 'bg-sage-100 flex items-center justify-center']}>
              <div class="text-center text-sage-300">
                <Camera size={32} class="mx-auto mb-1" aria-hidden="true" />
                <p class="font-body text-xs font-medium">{item.category}</p>
              </div>
            </div>

            <!-- Hover Overlay -->
            <div class="absolute inset-0 bg-bark-900/0 group-hover:bg-bark-900/60 transition-all duration-300 flex items-end p-5">
              <div class="translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
                <p class="font-heading text-lg font-bold text-white leading-snug">
                  {item.title}
                </p>
                <p class="font-body text-sm text-cream-200 mt-1">
                  {item.category}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA Section -->
  <section
    class="reveal relative overflow-hidden bg-sage-600 py-20 md:py-28"
    aria-labelledby="gallery-cta-heading"
  >
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,1) 10px, rgba(255,255,255,1) 12px);"
      aria-hidden="true"
    ></div>
    <div
      class="absolute inset-0 opacity-20"
      style="background: radial-gradient(ellipse at center, rgba(255,255,255,0.15) 0%, transparent 70%);"
      aria-hidden="true"
    ></div>

    <Container class="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2
          id="gallery-cta-heading"
          class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6"
        >
          Love What You See?
        </h2>
        <p class="font-body text-xl text-sage-100 leading-relaxed mb-10 max-w-2xl mx-auto">
          Let's create something beautiful for your home. Reach out for a free consultation and estimate.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={businessInfo.phone.href}
            class="inline-flex items-center justify-center gap-2 bg-white text-sage-700 font-body font-semibold rounded-lg px-8 py-4 text-lg shadow-md hover:shadow-lg hover:bg-cream-50 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <Phone size={20} aria-hidden="true" />
            Call {businessInfo.phone.display}
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center gap-2 bg-terra-500 text-white font-body font-semibold rounded-lg px-8 py-4 text-lg shadow-md hover:shadow-lg hover:bg-terra-600 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Request a Free Quote
          </a>
        </div>
      </div>
    </Container>
  </section>
</PageLayout>
