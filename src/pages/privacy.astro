---
/**
 * Privacy Policy — Standard small business privacy policy.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumbs from '../components/global/Breadcrumbs.astro';
import { businessInfo } from '../data/businessInfo';
---

<PageLayout
  title="Privacy Policy"
  description="La King Nursery's privacy policy. Learn how we collect, use, and protect your personal information when you contact us or visit our website."
>
  <!-- Hero Banner -->
  <section class="bg-sage-800 py-12 md:py-16" aria-label="Privacy policy introduction">
    <Container>
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Privacy Policy' },
        ]}
      />
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-white">
        Privacy Policy
      </h1>
    </Container>
  </section>

  <!-- Policy Content -->
  <section class="py-16 md:py-24 bg-cream-50">
    <Container size="narrow">
      <div class="prose max-w-3xl mx-auto">
        <p class="font-body text-sm text-bark-400 mb-8">
          Last updated: March 2026
        </p>

        <p class="font-body text-bark-600 leading-relaxed mb-8">
          {businessInfo.name} ("we," "us," or "our") is committed to protecting your privacy.
          This Privacy Policy explains what information we collect when you visit our website or
          contact us, how we use that information, and your choices regarding your data.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Information We Collect
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-4">
          When you fill out our contact form or request a quote, we may collect the following information:
        </p>
        <ul class="font-body text-bark-600 leading-relaxed mb-8 list-disc pl-6 space-y-2">
          <li><strong>Name</strong> -- so we know who we are speaking with</li>
          <li><strong>Email address</strong> -- so we can respond to your inquiry</li>
          <li><strong>Phone number</strong> (optional) -- so we can call you if you prefer</li>
          <li><strong>Message content</strong> -- the details of your question or project</li>
          <li><strong>Service interest</strong> -- to help us provide relevant information</li>
        </ul>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          How We Use Your Information
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-4">
          We use the information you provide solely to:
        </p>
        <ul class="font-body text-bark-600 leading-relaxed mb-8 list-disc pl-6 space-y-2">
          <li>Respond to your inquiry or quote request</li>
          <li>Provide you with information about our services</li>
          <li>Follow up on your project or question as needed</li>
          <li>Send you seasonal tips and updates if you subscribe to our newsletter (you can unsubscribe at any time)</li>
        </ul>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          We Do Not Sell or Share Your Data
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-8">
          Your personal information is never sold, traded, rented, or shared with third parties
          for marketing purposes. Period. We are a local family-owned nursery, and we treat your
          information the way we would want ours treated.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Cookies and Analytics
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-4">
          Our website may use cookies and similar technologies for the following purposes:
        </p>
        <ul class="font-body text-bark-600 leading-relaxed mb-4 list-disc pl-6 space-y-2">
          <li><strong>Essential cookies</strong> -- required for basic website functionality</li>
          <li><strong>Analytics cookies</strong> -- if Google Analytics is enabled, we collect anonymous usage data (pages visited, time on site, general geographic region) to understand how visitors use our website and improve the experience</li>
        </ul>
        <p class="font-body text-bark-600 leading-relaxed mb-8">
          Analytics data is aggregated and anonymous. We do not use it to personally identify visitors.
          You can disable cookies in your browser settings at any time.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Data Security
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-8">
          We take reasonable measures to protect your information from unauthorized access,
          alteration, or disclosure. Our website uses HTTPS encryption to protect data in transit.
          However, no method of electronic transmission or storage is 100% secure, and we cannot
          guarantee absolute security.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Third-Party Links
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-8">
          Our website may contain links to third-party sites (such as our Facebook page or Google Maps).
          We are not responsible for the privacy practices of these external sites. We encourage you
          to review their privacy policies.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Your Rights
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-4">
          You have the right to:
        </p>
        <ul class="font-body text-bark-600 leading-relaxed mb-8 list-disc pl-6 space-y-2">
          <li>Request access to the personal information we have about you</li>
          <li>Request correction or deletion of your personal information</li>
          <li>Unsubscribe from any marketing communications</li>
          <li>Contact us with any privacy-related questions or concerns</li>
        </ul>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Changes to This Policy
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-8">
          We may update this Privacy Policy from time to time. Any changes will be posted on this
          page with an updated revision date. We encourage you to review this page periodically.
        </p>

        <h2 class="font-heading text-2xl font-bold text-bark-800 mt-12 mb-4">
          Contact Us About Privacy
        </h2>
        <p class="font-body text-bark-600 leading-relaxed mb-4">
          If you have any questions about this Privacy Policy or how we handle your information,
          please contact us:
        </p>
        <address class="font-body text-bark-600 not-italic leading-relaxed mb-8">
          <strong class="text-bark-800">{businessInfo.name}</strong><br />
          {businessInfo.address.full}<br />
          Phone: <a href={businessInfo.phone.href} class="text-sage-600 hover:text-sage-700 underline transition-colors">{businessInfo.phone.display}</a><br />
          Or use our <a href="/contact/" class="text-sage-600 hover:text-sage-700 underline transition-colors">contact form</a>.
        </address>
      </div>
    </Container>
  </section>
</PageLayout>
