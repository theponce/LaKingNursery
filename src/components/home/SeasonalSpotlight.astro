---
/**
 * SeasonalSpotlight — Highlights current season planting opportunities.
 * Alternating layout with image left, content right.
 */
import Container from '../ui/Container.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { CircleCheck, Sprout } from '@lucide/astro';

const currentMonth = new Date().toLocaleString('en-US', { month: 'long' });
const currentYear = new Date().getFullYear();

const plantList = [
  'Fresh tomatoes, peppers & herbs',
  'Native Texas wildflowers',
  'Citrus trees & tropical plants',
  'Premium soils & mulch',
];
---

<section class="reveal bg-sage-50 py-16 md:py-24" aria-labelledby="seasonal-heading">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <!-- Image placeholder -->
      <div class="reveal-left relative">
        <div
          class="aspect-[4/3] bg-sage-200 rounded-2xl flex flex-col items-center justify-center overflow-hidden"
          role="img"
          aria-label="Seasonal plants at La King Nursery"
        >
          <Sprout size={64} class="text-sage-400 mb-3" aria-hidden="true" />
          <span class="text-sage-500 font-body text-sm font-medium">Seasonal Photo</span>
        </div>
        <!-- Decorative accent -->
        <div
          class="absolute -bottom-4 -right-4 w-24 h-24 bg-gold-200 rounded-2xl -z-10"
          aria-hidden="true"
        ></div>
      </div>

      <!-- Content -->
      <div class="reveal-right">
        <Badge variant="sage" class="mb-4">
          {currentMonth} {currentYear}
        </Badge>

        <SectionHeader
          overline="What's Growing Now"
          title="Spring Planting Season is Here"
          align="left"
          class="mb-6"
        />

        <p class="font-body text-bark-600 text-lg leading-relaxed mb-8" id="seasonal-heading">
          South Texas Zone 9b is perfect for starting your spring garden. Visit us
          for fresh vegetables, native wildflowers, citrus trees, and everything
          you need to get growing.
        </p>

        <ul class="space-y-3 mb-8" role="list">
          {plantList.map((item) => (
            <li class="flex items-center gap-3">
              <CircleCheck size={20} class="text-sage-500 flex-shrink-0" aria-hidden="true" />
              <span class="font-body text-bark-700">{item}</span>
            </li>
          ))}
        </ul>

        <Button variant="cta" href="/contact/">
          Visit Us Today
        </Button>
      </div>
    </div>
  </Container>
</section>
