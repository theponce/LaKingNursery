---
/**
 * SectionHeader — Reusable heading block for page sections.
 * Provides consistent overline, title, and subtitle pattern.
 */
export interface Props {
  overline?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center' | 'right';
  class?: string;
  dark?: boolean;
}

const {
  overline,
  title,
  subtitle,
  align = 'center',
  class: className = '',
  dark = false,
} = Astro.props;

const alignClasses: Record<string, string> = {
  left: 'text-left',
  center: 'text-center mx-auto',
  right: 'text-right ml-auto',
};

const overlineColor = dark ? 'text-gold-400' : 'text-terra-500';
const titleColor = dark ? 'text-white' : 'text-bark-800';
const subtitleColor = dark ? 'text-cream-300' : 'text-bark-500';
---

<div class:list={['max-w-2xl mb-12', alignClasses[align], className]}>
  {overline && (
    <p class:list={[
      'font-body text-sm font-semibold uppercase tracking-widest mb-3',
      overlineColor,
    ]}>
      {overline}
    </p>
  )}
  <h2 class:list={[
    'font-heading text-3xl md:text-4xl lg:text-5xl font-bold',
    titleColor,
  ]}>
    {title}
  </h2>
  {subtitle && (
    <p class:list={[
      'mt-4 text-lg md:text-xl leading-relaxed',
      subtitleColor,
    ]}>
      {subtitle}
    </p>
  )}
</div>
