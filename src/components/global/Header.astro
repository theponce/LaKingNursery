---
/**
 * Header — sticky site header with utility bar, navigation, and mobile toggle.
 *
 * Top bar: phone (click-to-call), Est. 1998 badge, Facebook link.
 * Main bar: brand name (logo placeholder), desktop nav, CTA, hamburger.
 */
import { Phone, Facebook, Menu } from "@lucide/astro";
import { businessInfo } from "@/data/businessInfo";
import { mainNav } from "@/data/navigation";
import MobileDrawer from "./MobileDrawer.astro";
---

<header class="sticky top-0 z-40 w-full">
  <!-- ─── Utility Bar ─── -->
  <div class="bg-sage-800 text-cream-100">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-1.5 text-xs sm:text-sm">
      <!-- Phone -->
      <a
        href={businessInfo.phone.href}
        class="inline-flex items-center gap-1.5 text-cream-200 transition-colors hover:text-white focus:text-white"
        aria-label={`Call us at ${businessInfo.phone.display}`}
      >
        <Phone class="h-3.5 w-3.5" aria-hidden="true" />
        <span>{businessInfo.phone.display}</span>
      </a>

      <!-- Est. Badge -->
      <span class="hidden font-heading text-xs tracking-wide text-cream-300 sm:inline">
        Est. {businessInfo.established}
      </span>

      <!-- Facebook -->
      <a
        href={businessInfo.social.facebook}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-cream-200 transition-colors hover:text-white focus:text-white"
        aria-label="Follow us on Facebook"
      >
        <Facebook class="h-3.5 w-3.5" aria-hidden="true" />
        <span class="hidden sm:inline">Facebook</span>
      </a>
    </div>
  </div>

  <!-- ─── Main Navigation Bar ─── -->
  <nav
    class="border-b border-cream-200 bg-cream-50/95 shadow-sm backdrop-blur-md"
    aria-label="Main navigation"
  >
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 lg:py-4">
      <!-- Brand / Logo -->
      <a href="/" class="group flex items-center gap-2" aria-label={`${businessInfo.name} — Home`}>
        <!-- Placeholder leaf icon — replace with logo image when ready -->
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-sage-500 text-lg font-bold text-white transition-colors group-hover:bg-sage-600" aria-hidden="true">
          LK
        </span>
        <span class="flex flex-col leading-tight">
          <span class="font-heading text-lg font-bold text-bark-800 transition-colors group-hover:text-sage-700 lg:text-xl">
            La King
          </span>
          <span class="text-[0.65rem] font-semibold uppercase tracking-widest text-sage-600 lg:text-xs">
            Nursery
          </span>
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <ul class="hidden items-center gap-1 lg:flex" role="list">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-md px-3 py-2 text-sm font-medium text-bark-700 transition-colors hover:bg-sage-50 hover:text-sage-700 focus:bg-sage-50 focus:text-sage-700"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <!-- CTA Button — Desktop -->
        <a
          href={businessInfo.urls.quote}
          class="hidden rounded-lg bg-terra-500 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:bg-terra-600 hover:shadow-md focus:bg-terra-600 focus:shadow-md active:bg-terra-700 lg:inline-flex"
        >
          Free Quote
        </a>

        <!-- Mobile Hamburger -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-bark-600 transition-colors hover:bg-sage-50 hover:text-sage-700 focus:bg-sage-50 focus:text-sage-700 lg:hidden"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile Drawer (rendered here so it's in DOM) -->
<MobileDrawer />
