---
/**
 * Footer — site-wide footer with brand info, links, contact, and newsletter.
 *
 * 5-column grid (collapses on mobile):
 *   1. Brand + tagline  2. Quick Links  3. Services  4. Service Areas  5. Contact
 * Newsletter signup row beneath. Copyright bar at the bottom.
 */
import { Phone, MapPin, Clock, Facebook } from "@lucide/astro";
import { businessInfo } from "@/data/businessInfo";
import { mainNav, serviceLinks, serviceAreaLinks } from "@/data/navigation";

const currentYear = new Date().getFullYear();
---

<footer class="bg-sage-800 text-cream-100" role="contentinfo">
  <!-- ─── Main Footer Grid ─── -->
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-10 lg:pt-16 lg:pb-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5 lg:gap-8">
      <!-- Column 1: Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="group inline-flex items-center gap-2" aria-label={`${businessInfo.name} — Home`}>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-sage-500 text-lg font-bold text-white transition-colors group-hover:bg-sage-400" aria-hidden="true">
            LK
          </span>
          <span class="flex flex-col leading-tight">
            <span class="font-heading text-lg font-bold text-white">La King</span>
            <span class="text-[0.65rem] font-semibold uppercase tracking-widest text-sage-300">Nursery</span>
          </span>
        </a>
        <p class="mt-3 font-heading text-sm italic text-sage-300">
          {businessInfo.tagline}
        </p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream-300">
          {businessInfo.description}
        </p>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="font-heading text-base font-semibold text-white">Quick Links</h3>
        <ul class="mt-4 space-y-2.5" role="list">
          {mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Services -->
      <div>
        <h3 class="font-heading text-base font-semibold text-white">Services</h3>
        <ul class="mt-4 space-y-2.5" role="list">
          {serviceLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Service Areas -->
      <div>
        <h3 class="font-heading text-base font-semibold text-white">Service Areas</h3>
        <ul class="mt-4 space-y-2.5" role="list">
          {serviceAreaLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 5: Contact Info -->
      <div>
        <h3 class="font-heading text-base font-semibold text-white">Contact Us</h3>
        <ul class="mt-4 space-y-4" role="list">
          <!-- Address -->
          <li>
            <a
              href={businessInfo.address.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-2.5 text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              aria-label={`Visit us at ${businessInfo.address.full}`}
            >
              <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-sage-400" aria-hidden="true" />
              <span>{businessInfo.address.full}</span>
            </a>
          </li>

          <!-- Phone -->
          <li>
            <a
              href={businessInfo.phone.href}
              class="flex items-center gap-2.5 text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              aria-label={`Call us at ${businessInfo.phone.display}`}
            >
              <Phone class="h-4 w-4 shrink-0 text-sage-400" aria-hidden="true" />
              <span>{businessInfo.phone.display}</span>
            </a>
          </li>

          <!-- Hours -->
          <li class="flex items-start gap-2.5 text-sm text-cream-300">
            <Clock class="mt-0.5 h-4 w-4 shrink-0 text-sage-400" aria-hidden="true" />
            <div>
              {businessInfo.hours.structured.map((entry) => (
                <p>
                  <span class="font-medium text-cream-200">{entry.days}:</span>{" "}
                  {entry.hours}
                </p>
              ))}
            </div>
          </li>

          <!-- Facebook -->
          <li>
            <a
              href={businessInfo.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2.5 text-sm text-cream-300 transition-colors hover:text-cream-100 focus:text-cream-100"
              aria-label="Follow us on Facebook"
            >
              <Facebook class="h-4 w-4 shrink-0 text-sage-400" aria-hidden="true" />
              <span>Follow on Facebook</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ─── Newsletter Signup ─── -->
  <div class="border-t border-sage-700">
    <div class="mx-auto max-w-7xl px-4 py-8 lg:py-10">
      <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left">
        <div>
          <h3 class="font-heading text-lg font-semibold text-white">
            Get Seasonal Growing Tips
          </h3>
          <p class="mt-1 text-sm text-cream-300">
            Join our newsletter for South Texas gardening advice delivered to your inbox.
          </p>
        </div>
        <form
          class="flex w-full max-w-md gap-2 sm:w-auto"
          action="#newsletter"
          method="POST"
          aria-label="Newsletter signup"
        >
          <label for="footer-email" class="sr-only">Email address</label>
          <input
            id="footer-email"
            type="email"
            name="email"
            required
            placeholder="your@email.com"
            autocomplete="email"
            class="min-w-0 flex-1 rounded-lg border border-sage-600 bg-sage-700 px-4 py-2.5 text-sm text-cream-100 placeholder:text-sage-400 focus:border-sage-400 focus:outline-none focus:ring-2 focus:ring-sage-400"
          />
          <button
            type="submit"
            class="shrink-0 rounded-lg bg-terra-500 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-terra-600 focus:bg-terra-600 active:bg-terra-700"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- ─── Copyright Bar ─── -->
  <!-- pb-20 on mobile accounts for the fixed MobileCTA bar (60px + safe area) -->
  <div class="border-t border-sage-700 bg-sage-900">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 pb-20 pt-4 text-xs text-sage-400 sm:flex-row md:pb-4">
      <p>&copy; {currentYear} {businessInfo.name}. All rights reserved.</p>
      <p class="flex items-center gap-3">
        <span>Family-owned since {businessInfo.established}</span>
        <span aria-hidden="true" class="text-sage-600">&middot;</span>
        <a
          href="/privacy/"
          class="transition-colors hover:text-cream-200 focus:text-cream-200"
        >
          Privacy Policy
        </a>
      </p>
    </div>
  </div>
</footer>
